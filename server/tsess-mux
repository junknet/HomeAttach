#!/usr/bin/env python3
"""Carry every attached HomeAttach session over one channel.

The phone opens this once, as a single SSH exec channel, and drives all of its
terminals through it. That is the whole point: one channel means opening and
closing a session is a frame rather than an SSH channel lifecycle, so tearing
one down can no longer disturb the others.

What that buys has to be paid for in scheduling. SSH gives every channel its own
flow-control window, and collapsing N channels into one throws that away — a
session dumping a build log would sit on the shared stream and freeze every
other terminal. So the loop below never lets one session write more than
[CHUNK_BYTES] before the next one gets a turn, and stops reading a session whose
backlog is already [SESSION_BUFFER_LIMIT], letting its own pty apply the
backpressure instead of buffering it here.

The same channel also carries the host's own state on slot 0 — the session list
and which sessions are producing output. That is not a convenience: the phone
lights a lamp for every session it can see, not only the ones it has attached,
and a second channel for that meant a second protocol, a second reconnect loop
and a second clock. Two clocks is precisely why the lamps used to disagree.

Protocol (see server/tests/muxproto.py, which is the spec the tests speak):

    | type:1 | sid:1 | length:4 big-endian | payload |

    client -> mux   OPEN(epoch,offset,tail,name) CLOSE INPUT(bytes) FOCUS(cols,rows)
    mux -> client   READY(mode,epoch,offset,replay,name) OUTPUT(bytes) ENDED ERROR
    mux -> client   SESSIONS(tsv) ACTIVITY(names)      -- slot 0 only

OPEN carries what the client already holds of that session, and READY answers
with what the host did about it: `continued` means the OUTPUT frames that follow
pick up exactly where the client left off, `snapshot` means they replace its
screen. The client counts OUTPUT bytes from the offset in READY - skipping the
first `replay` of them, which the offset already accounts for - and that count is
the cursor it saves. Which is why nothing but session output may ever be carried
in an OUTPUT frame.
"""

from __future__ import annotations

import errno
import json
import os
import pty
import re
import select
import shlex
import signal
import struct
import subprocess
import sys
import termios
import time
import tty
from pathlib import Path

# client -> mux
OPEN = 0x01
CLOSE = 0x02
INPUT = 0x03
FOCUS = 0x04
HISTORY = 0x05

# mux -> client
READY = 0x81
OUTPUT = 0x82
ENDED = 0x83
ERROR = 0x84

# mux -> client, slot 0: the host's state rather than any one session's.
SESSIONS = 0x85
ACTIVITY = 0x86
HISTORY_PAGE = 0x87

CONTROL_SLOT = 0

# READY modes, mirroring zmx's ResumeStatus.
RESUME_SNAPSHOT = 0
RESUME_CONTINUED = 1

# `| epoch:8 | offset:8 | tail_rows:4 | cols:2 | rows:2 |` before the session name in OPEN.
OPEN_HEADER = struct.Struct(">QQIHH")
# `| mode:1 | epoch:8 | offset:8 | replay:8 |` before the session name in READY.
READY_HEADER = struct.Struct(">BQQQ")

# How long the mux waits for zmx to report what it did with the resume request
# before giving up and telling the client its screen is stale. Only ever hit by
# a zmx too old to answer, in which case "assume stale" is the safe reading.
RESUME_REPORT_TIMEOUT_S = 3.0

# Scrollback rows a snapshot may carry. The phone keeps its own history; this
# only has to cover the screen it will show plus a little to scroll into.
SNAPSHOT_TAIL_ROWS = 200

HEADER = struct.Struct(">BBI")
MAX_PAYLOAD = 1 << 20
HISTORY_PAYLOAD_LIMIT = 512 * 1024
HISTORY_REQUEST_TIMEOUT_S = 5.0
HISTORY_PAGE_ROWS = 128
HISTORY_MAX_ROWS = 256

# One session's turn on the shared stream. Small enough that a flood cannot hold
# the channel long enough to be felt as a stall in another terminal.
CHUNK_BYTES = 8192

# Backlog past which a session stops being read. Its pty fills, the writer
# blocks, and the flood throttles itself — which is what the per-channel windows
# used to do for us.
SESSION_BUFFER_LIMIT = 256 * 1024

SELECT_TIMEOUT_S = 0.05
TERMINATE_GRACE_S = 1.0

# How often the host is asked which sessions emitted output, and the floor on
# how often that gets reported. A lamp says "something is happening over
# there", so a quarter second is below what the eye reads as lag, while one
# `zmx stat` covering every session keeps the poll to four processes a second
# no matter how many sessions exist.
ACTIVITY_POLL_S = 0.25

# How long a poll's answer may be reused to open a session without re-asking the
# daemon. Comfortably more than [ACTIVITY_POLL_S], so the normal case is always a
# hit, and short enough that a poll which has stopped running cannot keep
# answering for daemons it can no longer see.
STAT_CACHE_MAX_AGE_S = 2.0

# The full list walks /proc per session in a shell script. It only has to be as
# fresh as the running command and cwd, which change on human timescales; a
# session appearing or disappearing does not wait for it (see [SessionStatus]).
SESSION_LIST_INTERVAL_S = 5.0

# Retry delay for a status command that could not be started at all.
SPAWN_RETRY_S = 5.0

# Asking one daemon whether it can resume. Short: it is a unix socket round trip
# on the same machine, and a session open waits on it.
DAEMON_PROBE_TIMEOUT_S = 2.0


def zmx_environment() -> dict[str, str]:
    """The environment zmx is spawned with.

    ZMX_SESSION has to go. Any login shell that has been inside a session exports it, and zmx reads
    it as "switch the session I am already in" rather than "attach to the one named on the command
    line" — so a mux started over SSH from such an environment would drive the wrong terminal for
    every session it opens.
    """
    env = dict(os.environ)
    env.pop("ZMX_SESSION", None)
    return env


def zmx_command() -> list[str]:
    """Same resolution order as tsess-state, so both agree on which zmx runs."""
    override = os.environ.get("HOMEATTACH_ZMX")
    if override:
        return shlex.split(override)
    here = Path(__file__).resolve().parent
    for candidate in (here / "zmx", here / "zmx" / "zig-out" / "bin" / "zmx"):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return [str(candidate)]
    return ["zmx"]


def session_list_command() -> list[str]:
    """The one definition of what a session list is: `tsess-list`, next to us.

    Rebuilding the list here in Python would be cheaper by one process and
    wrong by one implementation — the columns, the /proc walk and the cwd
    shortening would then exist twice and drift apart.
    """
    override = os.environ.get("HOMEATTACH_TSESS_LIST")
    if override:
        return shlex.split(override)
    return [str(Path(__file__).resolve().parent / "tsess-list")]


class BackgroundCommand:
    """A host command whose output is collected inside the select loop.

    The data path must never block on one: `tsess-list` walks /proc for every
    session, and waiting for it inline would be that walk's whole duration of
    stall in every attached terminal, several times a minute.
    """

    def __init__(self, argv: list[str], env: dict[str, str],
                 output_limit: int | None = None):
        self.proc = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=env,
        )
        self.fd = self.proc.stdout.fileno()
        os.set_blocking(self.fd, False)
        self.out = bytearray()
        self.output_limit = output_limit
        self.overflowed = False

    def read(self) -> bool:
        """Drains what is ready. True once the command is done and [out] is whole."""
        for iteration in range(4):
            try:
                chunk = os.read(self.fd, 65536)
            except BlockingIOError:
                return False
            except OSError:
                return True
            if not chunk:
                return True
            if self.output_limit is not None and len(self.out) + len(chunk) > self.output_limit:
                self.overflowed = True
                return True
            self.out.extend(chunk)
        return False

    def close(self) -> subprocess.Popen:
        try:
            self.proc.stdout.close()
        except OSError:
            pass
        return self.proc

    def failed(self) -> bool:
        """Whether the command exited non-zero. Only called on EOF, so the wait
        is a formality with a bound on it rather than a blocking join."""
        try:
            return self.proc.wait(timeout=0.2) != 0
        except subprocess.TimeoutExpired:
            return False

    @property
    def text(self) -> str:
        return bytes(self.out).decode("utf-8", "replace")


def parse_stat(text: str) -> dict[str, dict[str, str]]:
    """`zmx stat` bulk output -> {session name: its `key=value` fields}.

    The bulk form prints the same fields the single-session form does, which is
    what lets [SessionStatus.capabilities] answer from the poll a question an
    attach would otherwise spend a whole process on.
    """
    sessions: dict[str, dict[str, str]] = {}
    for line in text.splitlines():
        fields = dict(
            field.split("=", 1) for field in line.split() if "=" in field
        )
        name = fields.get("name")
        if not name:
            continue
        sessions[name] = fields
    return sessions


def stat_sequence(fields: dict[str, str]) -> int:
    try:
        return int(fields.get("output_seq", "0"))
    except ValueError:
        return 0


class SessionStatus:
    """The host's session list and per-session activity, on the control slot.

    Every session the phone can see needs its own activity signal, not just the
    attached ones: the list screen and the drawer light a lamp per row. Attached
    sessions report themselves through [note_output] the moment their bytes
    arrive; the rest come from `zmx stat`, which answers for all of them in one
    process, so the poll costs the same whether the user keeps two sessions or
    twenty.

    Membership changes do not wait for the list heartbeat — the stat poll is
    what notices a session was born or died, and it runs four times a second.
    """

    def __init__(self, zmx: list[str], env: dict[str, str]):
        self.zmx = zmx
        self.env = env
        self.list_command = session_list_command()
        self.active: set[str] = set()
        self.sequences: dict[str, int] = {}
        # The last poll's raw fields, and when it landed. Opening a session reads
        # them instead of probing the daemon itself; see [capabilities].
        self.stats: dict[str, dict[str, str]] = {}
        self.stats_at = 0.0
        self.stat_job: BackgroundCommand | None = None
        self.list_job: BackgroundCommand | None = None
        self.reaping: list[subprocess.Popen] = []
        self.pending: list[tuple[int, bytes]] = []
        self.next_stat_at = 0.0
        self.next_activity_at = 0.0
        self.next_list_at = 0.0
        self.unstartable: set[str] = set()

    def note_output(self, name: str) -> None:
        """An attached session just produced bytes — no poll can beat this."""
        self.active.add(name)

    def capabilities(self, name: str) -> tuple[bool, bool] | None:
        """What the last poll saw of [name]'s daemon: (resumable, history pages).

        None means "go ask it yourself". Only a line that actually carried an
        `epoch` proves anything: the field arrived with the resume patches, so a
        line without it is either a daemon that predates them or a session this
        poll has not seen yet, and those two have to be told apart by the probe.
        A line that has it came from the same daemon the probe would have asked,
        so believing it is not a weaker check - only a cheaper one.

        Bounded by age rather than trusted forever: if the poll stops running
        (its binary went missing) these fields stay behind silently, and a stale
        yes is exactly the answer that attaches a non-mirror client to a daemon
        that cannot take one.
        """
        if time.monotonic() - self.stats_at > STAT_CACHE_MAX_AGE_S:
            return None
        fields = self.stats.get(name)
        if fields is None or "epoch" not in fields:
            return None
        return True, fields.get("history_pages") == "1"

    def fds(self) -> list[int]:
        return [job.fd for job in (self.stat_job, self.list_job) if job is not None]

    def on_readable(self, readable: list[int]) -> None:
        if self.stat_job is not None and self.stat_job.fd in readable:
            if self.stat_job.read():
                self.finish_stat()
        if self.list_job is not None and self.list_job.fd in readable:
            if self.list_job.read():
                self.finish_list()

    def finish_stat(self) -> None:
        job, self.stat_job = self.stat_job, None
        if job is None:
            return
        self.reaping.append(job.close())
        sessions = parse_stat(job.text)
        self.stats = sessions
        self.stats_at = time.monotonic()
        sequences = {name: stat_sequence(f) for name, f in sessions.items()}
        for name, sequence in sequences.items():
            previous = self.sequences.get(name)
            if previous is not None and sequence != previous:
                self.active.add(name)
        if sequences.keys() != self.sequences.keys():
            # Born or died: the list on the phone is wrong right now, not in
            # five seconds.
            self.next_list_at = 0.0
        self.sequences = sequences

    def finish_list(self) -> None:
        job, self.list_job = self.list_job, None
        if job is None:
            return
        proc = job.close()
        self.reaping.append(proc)
        if job.failed():
            # An empty list is the normal answer when nothing is running; an
            # empty list from a script that could not run is not, and the phone
            # can only tell them apart if we say which one this was.
            self.pending.append(
                (ERROR, f"{self.list_command[0]} failed".encode("utf-8"))
            )
            return
        self.pending.append((SESSIONS, bytes(job.out)))

    def drain(self, now: float) -> list[tuple[int, bytes]]:
        """Frames to send on the control slot, and the work that produces them."""
        frames, self.pending = self.pending, []
        self.reaping = [p for p in self.reaping if p.poll() is None]

        if self.stat_job is None and now >= self.next_stat_at:
            self.stat_job = self.spawn(self.zmx + ["stat"])
            # A command that cannot even start will not start 250ms from now
            # either; retrying at poll speed would only spin and flood stderr.
            self.next_stat_at = now + (ACTIVITY_POLL_S if self.stat_job else SPAWN_RETRY_S)

        if self.list_job is None and now >= self.next_list_at:
            self.list_job = self.spawn(self.list_command)
            self.next_list_at = now + (
                SESSION_LIST_INTERVAL_S if self.list_job else SPAWN_RETRY_S
            )

        if self.active and now >= self.next_activity_at:
            self.next_activity_at = now + ACTIVITY_POLL_S
            frames.append((ACTIVITY, "\n".join(sorted(self.active)).encode("utf-8")))
            self.active.clear()

        return frames

    def spawn(self, argv: list[str]) -> BackgroundCommand | None:
        try:
            return BackgroundCommand(argv, self.env)
        except OSError as exc:
            # Once per command: this is polled, and the same missing binary
            # reported four times a second would bury everything else on stderr.
            if argv[0] not in self.unstartable:
                self.unstartable.add(argv[0])
                print(f"tsess-mux: cannot run {argv[0]}: {exc}", file=sys.stderr)
            return None

    def shutdown(self) -> None:
        for job in (self.stat_job, self.list_job):
            if job is None:
                continue
            proc = job.close()
            if proc.poll() is None:
                proc.kill()


class Session:
    """One attached session: its mirror client, its pty, and its backlog."""

    def __init__(self, sid: int, name: str, proc: subprocess.Popen, master_fd: int,
                 err_fd: int):
        self.sid = sid
        self.name = name
        self.proc = proc
        self.master_fd = master_fd
        # zmx reports what it did with the resume request here. Kept off the pty
        # deliberately: stdout is the terminal stream, and a control line in it
        # would be rendered as terminal output on the phone.
        self.err_fd = err_fd
        self.err_open = True
        self.errbuf = bytearray()
        self.outbuf = bytearray()
        # Nothing may leave for the client until READY says whether what follows
        # continues its screen or replaces it.
        self.ready_sent = False
        self.ready_deadline = time.monotonic() + RESUME_REPORT_TIMEOUT_S
        # Only a session that claimed the pty size has anything to hand back.
        self.claimed = False
        self.history_supported = False
        self.history_columns = 0
        self.history_job: BackgroundCommand | None = None
        self.history_request: tuple[str, int, int] | None = None
        self.history_deadline = 0.0

    @property
    def backlogged(self) -> bool:
        return len(self.outbuf) >= SESSION_BUFFER_LIMIT


RESUME_LINE = re.compile(rb"zmx-resume mode=(\w+) epoch=(\d+) offset=(\d+) bytes=(\d+)")


def valid_history_anchor(anchor: object) -> bool:
    return (isinstance(anchor, str) and re.fullmatch(r"0|[1-9][0-9]{0,19}", anchor)
            is not None and int(anchor) <= 0xffffffffffffffff)


def valid_history_page(payload: bytes, anchor: str, before: int, limit: int) -> bool:
    try:
        response = json.loads(payload.decode("utf-8"))
        if not isinstance(response, dict):
            return False
        rows = response["rows"]
        following = response["next"]
        columns = response["columns"]
        if (response["anchor"] != anchor or type(response["before"]) is not int
                or response["before"] != before or type(following) is not int
                or type(columns) is not int or not 0 <= columns <= 65535
                or type(response["more"]) is not bool or not isinstance(rows, list)
                or len(rows) > limit or following != before + len(rows)
                or following > 0x7fffffffffffffff):
            return False
        if response["status"] in ("expired", "unsupported"):
            return not rows and not response["more"]
        if response["status"] != "ok" or columns == 0:
            return False
        if not rows and response["more"]:
            return False
        return all(isinstance(history_row, dict)
                   and isinstance(history_row.get("text"), str)
                   and type(history_row.get("wrapped")) is bool
                   and "\n" not in history_row["text"]
                   and "\r" not in history_row["text"]
                   for history_row in rows)
    except (ValueError, KeyError, TypeError, UnicodeError, RecursionError):
        return False


class Mux:
    def __init__(self) -> None:
        self.zmx = zmx_command()
        self.zmx_env = zmx_environment()
        self.sessions: dict[int, Session] = {}
        self.inbuf = bytearray()
        self.pending_out = bytearray()
        self.turn_order: list[int] = []
        self.turn_index = 0
        self.reaping: list[subprocess.Popen] = []
        self.stdin_open = True
        self.status = SessionStatus(self.zmx, self.zmx_env)

    # ---------- framing ----------

    def queue(self, type_: int, sid: int, payload: bytes = b"") -> None:
        self.pending_out.extend(HEADER.pack(type_, sid, len(payload)) + payload)

    def parse_input(self) -> None:
        while True:
            if len(self.inbuf) < HEADER.size:
                return
            type_, sid, length = HEADER.unpack_from(self.inbuf, 0)
            if length > MAX_PAYLOAD:
                # Framing is lost; there is no way to resynchronise a stream
                # whose length fields cannot be trusted.
                raise SystemExit("tsess-mux: framing lost, oversized length")
            end = HEADER.size + length
            if len(self.inbuf) < end:
                return
            payload = bytes(self.inbuf[HEADER.size:end])
            del self.inbuf[:end]
            self.dispatch(type_, sid, payload)

    def dispatch(self, type_: int, sid: int, payload: bytes) -> None:
        if type_ == OPEN:
            self.open_session(sid, payload)
            return
        session = self.sessions.get(sid)
        if session is None:
            self.queue(ERROR, sid, b"no such session slot")
            return
        if type_ == INPUT:
            self.write_to_session(session, payload)
        elif type_ == FOCUS:
            self.focus_session(session, payload)
        elif type_ == HISTORY:
            self.request_history(session, payload)
        elif type_ == CLOSE:
            self.close_session(session)
        else:
            self.queue(ERROR, sid, b"unknown frame type")

    # ---------- sessions ----------

    def daemon_capabilities(self, name: str) -> tuple[bool, bool]:
        """Whether this daemon can resume, and whether it serves history pages.

        A daemon older than the resume patches ignores the init message that
        asks for one, and a mirror it never registered as a mirror is a client
        that can take the pty size - i.e. resize the terminal someone is working
        in. So capability is checked before attaching, not assumed and repaired
        afterwards.

        The activity poll already asks every daemon the same question four times
        a second, and its answer carries the same fields, so an open normally
        costs no process at all here. The probe below is what covers the cases
        the poll cannot speak for - a session younger than the last poll, or a
        daemon too old to have printed the fields that settle it.
        """
        cached = self.status.capabilities(name)
        if cached is not None:
            return cached
        try:
            out = subprocess.run(
                self.zmx + ["stat", name], capture_output=True, text=True,
                env=self.zmx_env, timeout=DAEMON_PROBE_TIMEOUT_S,
            ).stdout
        except (OSError, subprocess.SubprocessError):
            return False, False
        fields = dict(field.split("=", 1) for field in out.split() if "=" in field)
        try:
            int(fields["epoch"])
        except (KeyError, ValueError):
            return False, False
        return True, fields.get("history_pages") == "1"

    def open_session(self, sid: int, payload: bytes) -> None:
        if sid == 0:
            self.queue(ERROR, sid, b"slot 0 is reserved")
            return
        # `| epoch:8 | offset:8 | tail:4 | name |`; a bare name is a client that
        # holds nothing and wants the session from scratch.
        epoch = offset = cols = rows = 0
        tail_rows = SNAPSHOT_TAIL_ROWS
        if len(payload) >= OPEN_HEADER.size:
            epoch, offset, tail_rows, cols, rows = OPEN_HEADER.unpack_from(payload, 0)
            payload = payload[OPEN_HEADER.size:]
        # A client that names no cap gets ours rather than the daemon's whole
        # scrollback: "unlimited" is never what a phone wants, and a build that
        # forgets to ask should not be the one that pays for it.
        if tail_rows <= 0:
            tail_rows = SNAPSHOT_TAIL_ROWS
        try:
            name = payload.decode("utf-8")
        except UnicodeDecodeError:
            self.queue(ERROR, sid, b"session name is not utf-8")
            return

        previous = self.sessions.get(sid)
        if previous is not None:
            if previous.name != name or epoch != 0 or offset != 0:
                self.queue(ERROR, sid, b"session slot already in use")
                return
            self.teardown(previous)

        master_fd, slave_fd = pty.openpty()
        # Raw, and this is not optional: in canonical mode the pty holds input
        # until a newline, so arrow keys and Ctrl-C never reach the session, and
        # with ECHO on every keystroke comes back twice — once from the pty and
        # once from the session itself.
        try:
            tty.setraw(slave_fd, termios.TCSANOW)
        except termios.error:
            pass
        if cols > 0 and rows > 0:
            # Take the size before the host draws anything, so the picture it
            # sends is made for the geometry it will be shown at. Without this a
            # snapshot is serialized at the PC's width and painted at the phone's:
            # every line that wraps differently shifts the rest down, and the
            # absolute cursor the snapshot ends with then lands on a line of
            # content, which the next output overwrites. The client claims this
            # size a frame later anyway - this only stops it being late.
            self.run_blocking(["claim", name, str(cols), str(rows)])

        resumable, history_supported = self.daemon_capabilities(name)
        attach_args = ["attach", "--mirror"]
        if resumable:
            attach_args += ["--resume", f"{epoch}:{offset}", "--tail", str(tail_rows)]
        if history_supported:
            attach_args.append("--history-pages")
        attach_args.append(name)

        err_r, err_w = os.pipe()
        try:
            proc = subprocess.Popen(
                self.zmx + attach_args,
                stdin=slave_fd, stdout=slave_fd, stderr=err_w,
                env=self.zmx_env, close_fds=True,
            )
        except OSError as exc:
            for fd in (master_fd, slave_fd, err_r, err_w):
                os.close(fd)
            self.queue(ERROR, sid, f"cannot attach: {exc}".encode())
            return
        os.close(slave_fd)
        os.close(err_w)
        os.set_blocking(master_fd, False)
        os.set_blocking(err_r, False)

        # READY waits for zmx to say what it did; see [read_session_err]. Until
        # then the slot is not in turn_order, so none of its output can precede
        # the answer the client needs in order to interpret it.
        session = Session(sid, name, proc, master_fd, err_r)
        session.history_supported = history_supported
        self.sessions[sid] = session
        if not resumable:
            # An older daemon: it will send the session's whole picture, the way
            # it always has. Nothing to wait for, and nothing the client can keep.
            self.send_ready(session, RESUME_SNAPSHOT, 0, 0)
            self.history_response(session, "unsupported", "0", 0)

    def history_response(self, session: Session, status: str, anchor: str,
                         before: int, more: bool = False) -> None:
        response = {"status": status, "anchor": anchor, "before": before,
                    "next": before, "columns": session.history_columns,
                    "more": more, "rows": []}
        self.queue(HISTORY_PAGE, session.sid,
                   json.dumps(response, separators=(",", ":")).encode("utf-8"))

    def send_history_metadata(self, session: Session, report: bytes) -> None:
        if not session.history_supported:
            self.history_response(session, "unsupported", "0", 0)
            return
        fields = dict(field.split(b"=", 1) for field in bytes(report).split() if b"=" in field)
        try:
            anchor = fields[b"history"].decode("ascii")
            columns = int(fields[b"columns"])
            more = fields[b"more"]
            if not valid_history_anchor(anchor) or not 1 <= columns <= 65535:
                raise ValueError("invalid history metadata")
            if more not in (b"0", b"1"):
                raise ValueError("invalid history availability")
        except (KeyError, ValueError, UnicodeError):
            session.history_supported = False
            self.history_response(session, "unsupported", "0", 0)
            return
        session.history_columns = columns
        self.history_response(session, "ok", anchor, 0, more == b"1")

    def request_history(self, session: Session, payload: bytes) -> None:
        try:
            if len(payload) > 1024:
                raise ValueError("history request exceeds limit")
            request = json.loads(payload.decode("utf-8"))
            if not isinstance(request, dict):
                raise ValueError("history request must be object")
            anchor = request["anchor"]
            before = request["before"]
            limit = request.get("limit", HISTORY_PAGE_ROWS)
            if not valid_history_anchor(anchor):
                raise ValueError("history anchor must be unsigned decimal string")
            if type(before) is not int or not 0 <= before <= 0x7fffffffffffffff:
                raise ValueError("history before must be nonnegative integer")
            if type(limit) is not int or not 1 <= limit <= HISTORY_MAX_ROWS:
                raise ValueError("history limit outside supported range")
        except (ValueError, KeyError, TypeError, UnicodeError) as failure:
            self.queue(ERROR, session.sid, f"invalid history request: {failure}".encode())
            return
        if not session.history_supported:
            self.history_response(session, "unsupported", anchor, before)
            return
        request_identity = (anchor, before, limit)
        if session.history_job is not None:
            if session.history_request != request_identity:
                self.queue(ERROR, session.sid, b"history request already running")
            return
        try:
            session.history_job = BackgroundCommand(
                self.zmx + ["history-page", session.name, anchor, str(before), str(limit)],
                self.zmx_env, output_limit=HISTORY_PAYLOAD_LIMIT)
        except OSError:
            self.history_response(session, "expired", anchor, before)
            return
        session.history_request = request_identity
        session.history_deadline = time.monotonic() + HISTORY_REQUEST_TIMEOUT_S

    def cancel_history(self, session: Session) -> None:
        command, session.history_job = session.history_job, None
        session.history_request = None
        if command is None:
            return
        process = command.close()
        if process.poll() is None:
            try:
                process.kill()
            except OSError:
                pass
        self.reaping.append(process)

    def pump_history(self, readable: list[int]) -> None:
        current_time = time.monotonic()
        for session in list(self.sessions.values()):
            command = session.history_job
            request = session.history_request
            if command is None or request is None:
                continue
            anchor, before, limit = request
            expired = current_time >= session.history_deadline
            completed = command.fd in readable and command.read()
            if not expired and not completed:
                continue
            payload = bytes(command.out)
            valid = (not expired and not command.overflowed
                     and valid_history_page(payload, anchor, before, limit))
            self.cancel_history(session)
            if valid:
                self.queue(HISTORY_PAGE, session.sid, payload)
            else:
                self.history_response(session, "expired", anchor, before)
                self.queue(ERROR, session.sid, b"history page unavailable or malformed")

    def write_to_session(self, session: Session, data: bytes) -> None:
        try:
            os.write(session.master_fd, data)
        except OSError:
            # The session is going away; its EOF will report ENDED on its own.
            pass

    def focus_session(self, session: Session, payload: bytes) -> None:
        if len(payload) != 4:
            self.queue(ERROR, session.sid, b"focus payload must be cols,rows")
            return
        cols, rows = struct.unpack(">HH", payload)
        session.claimed = True
        self.run_detached(["claim", session.name, str(cols), str(rows)])

    def close_session(self, session: Session) -> None:
        if session.claimed:
            self.run_detached(["release", session.name])
        self.teardown(session)

    def teardown(self, session: Session) -> None:
        self.cancel_history(session)
        self.sessions.pop(session.sid, None)
        if session.sid in self.turn_order:
            self.turn_order.remove(session.sid)
        # Anything still buffered belongs to a session the client has let go of.
        session.outbuf.clear()
        self.close_err(session)
        try:
            os.close(session.master_fd)
        except OSError:
            pass
        self.stop_process(session.proc)

    def stop_process(self, proc: subprocess.Popen) -> None:
        if proc.poll() is not None:
            return
        try:
            proc.terminate()
        except OSError:
            return
        try:
            proc.wait(timeout=TERMINATE_GRACE_S)
        except subprocess.TimeoutExpired:
            # A mirror client that ignores SIGTERM would otherwise outlive this
            # process and pile up on the host on every dropped connection.
            try:
                proc.kill()
                proc.wait(timeout=TERMINATE_GRACE_S)
            except (OSError, subprocess.TimeoutExpired):
                pass

    def run_blocking(self, args: list[str]) -> None:
        """A `zmx` control verb whose effect must land before the next step. One
        unix-socket round trip on the same machine; only ever on session open."""
        try:
            subprocess.run(self.zmx + args, stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           env=self.zmx_env, timeout=DAEMON_PROBE_TIMEOUT_S)
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"tsess-mux: {args[0]} failed: {exc}", file=sys.stderr)

    def run_detached(self, args: list[str]) -> None:
        """Fire a `zmx` control verb without blocking the data path on it."""
        try:
            self.reaping.append(subprocess.Popen(
                self.zmx + args,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=self.zmx_env,
            ))
        except OSError as exc:
            print(f"tsess-mux: {args[0]} failed: {exc}", file=sys.stderr)

    def reap(self) -> None:
        self.reaping = [p for p in self.reaping if p.poll() is None]

    def pump_status(self) -> None:
        """Control-slot frames go ahead of session output on purpose: they are
        tens of bytes, and a lamp that lags the flood it is reporting is worse
        than useless."""
        for type_, payload in self.status.drain(time.monotonic()):
            self.queue(type_, CONTROL_SLOT, payload)

    # ---------- scheduling ----------

    def fill_pending(self) -> None:
        """One round of turns, so no session can precede another by more than
        [CHUNK_BYTES] on the shared stream."""
        if self.pending_out or not self.turn_order:
            return
        for _ in range(len(self.turn_order)):
            if not self.turn_order:
                return
            self.turn_index %= len(self.turn_order)
            sid = self.turn_order[self.turn_index]
            self.turn_index += 1
            session = self.sessions.get(sid)
            if session is None or not session.outbuf:
                continue
            take = bytes(session.outbuf[:CHUNK_BYTES])
            del session.outbuf[:len(take)]
            self.queue(OUTPUT, sid, take)

    def flush_pending(self) -> bool:
        """Writes what it can. False means the client is gone."""
        while self.pending_out:
            try:
                written = os.write(1, self.pending_out[:CHUNK_BYTES * 2])
            except BlockingIOError:
                return True
            except OSError as exc:
                if exc.errno in (errno.EPIPE, errno.EBADF):
                    return False
                raise
            if written == 0:
                return True
            del self.pending_out[:written]
        return True

    def read_session_err(self, session: Session) -> None:
        """zmx's control channel: one `zmx-resume` line, then whatever it logs.

        The resume line is what READY is waiting on, so this is also where a
        session becomes eligible to send output at all.
        """
        try:
            data = os.read(session.err_fd, 4096)
        except BlockingIOError:
            return
        except OSError:
            data = b""
        if not data:
            # zmx closed its control channel. If it never answered, it is too old
            # to know about resuming, and a stream that cannot say otherwise has
            # to be read as a snapshot.
            self.close_err(session)
            if not session.ready_sent:
                self.send_ready(session, RESUME_SNAPSHOT, 0, 0)
                session.history_supported = False
                self.history_response(session, "unsupported", "0", 0)
            return

        session.errbuf.extend(data)
        while b"\n" in session.errbuf:
            line, _, rest = session.errbuf.partition(b"\n")
            session.errbuf = bytearray(rest)
            match = RESUME_LINE.search(line)
            if match and not session.ready_sent:
                mode = (RESUME_CONTINUED if match.group(1) == b"continued"
                        else RESUME_SNAPSHOT)
                self.send_ready(session, mode, int(match.group(2)), int(match.group(3)),
                                int(match.group(4)))
                self.send_history_metadata(session, line)
            elif line.strip() and not match:
                print(f"tsess-mux: {session.name}: {line.decode('utf-8', 'replace')}",
                      file=sys.stderr)
        if len(session.errbuf) > CHUNK_BYTES:
            session.errbuf.clear()

    def close_err(self, session: Session) -> None:
        if not session.err_open:
            return
        session.err_open = False
        try:
            os.close(session.err_fd)
        except OSError:
            pass

    def send_ready(self, session: Session, mode: int, epoch: int, offset: int,
                   replay_bytes: int = 0) -> None:
        session.ready_sent = True
        self.queue(READY, session.sid,
                   READY_HEADER.pack(mode, epoch, offset, replay_bytes)
                   + session.name.encode("utf-8"))
        if session.sid not in self.turn_order:
            self.turn_order.append(session.sid)

    def expire_pending_ready(self) -> None:
        """A zmx that neither answers nor exits must not hold a terminal blank."""
        now = time.monotonic()
        for session in list(self.sessions.values()):
            if not session.ready_sent and now >= session.ready_deadline:
                self.send_ready(session, RESUME_SNAPSHOT, 0, 0)
                session.history_supported = False
                self.history_response(session, "unsupported", "0", 0)

    def read_session(self, session: Session) -> None:
        try:
            data = os.read(session.master_fd, CHUNK_BYTES)
        except BlockingIOError:
            return
        except OSError as exc:
            # EIO on a pty master is the normal way a slave-side exit shows up.
            data = b"" if exc.errno == errno.EIO else b""
        if not data:
            self.queue(ENDED, session.sid, b"session ended")
            self.teardown(session)
            return
        # An attached session's own bytes are the activity signal for it; the
        # stat poll exists for the sessions nobody has attached.
        self.status.note_output(session.name)
        session.outbuf.extend(data)

    # ---------- main loop ----------

    def run(self) -> int:
        os.set_blocking(1, False)
        if self.stdin_open:
            os.set_blocking(0, False)
        try:
            while True:
                self.reap()
                self.pump_status()
                self.fill_pending()

                read_fds: list[int] = []
                if self.stdin_open:
                    read_fds.append(0)
                read_fds.extend(self.status.fds())
                read_fds.extend(
                    session.history_job.fd for session in self.sessions.values()
                    if session.history_job is not None
                )
                # A backlogged session is not read: its pty fills up and the
                # writer blocks, which is the backpressure that keeps one noisy
                # terminal from being buffered at everyone else's expense.
                read_fds.extend(
                    s.master_fd for s in self.sessions.values() if not s.backlogged
                )
                read_fds.extend(
                    s.err_fd for s in self.sessions.values() if s.err_open
                )
                write_fds = [1] if self.pending_out else []

                if not read_fds and not write_fds and not self.sessions:
                    return 0

                try:
                    readable, writable, _ = select.select(
                        read_fds, write_fds, [], SELECT_TIMEOUT_S)
                except InterruptedError:
                    continue
                except OSError:
                    return 0

                if 1 in writable and not self.flush_pending():
                    return 0

                if 0 in readable:
                    try:
                        chunk = os.read(0, 65536)
                    except BlockingIOError:
                        chunk = b"pending"[:0]
                    except OSError:
                        chunk = b""
                    if chunk == b"" and 0 in readable:
                        # The client closed the channel: nothing left to serve.
                        self.stdin_open = False
                        return 0
                    self.inbuf.extend(chunk)
                    self.parse_input()

                for session in list(self.sessions.values()):
                    if session.err_open and session.err_fd in readable:
                        self.read_session_err(session)
                for session in list(self.sessions.values()):
                    if session.master_fd in readable:
                        self.read_session(session)
                self.expire_pending_ready()
                self.pump_history(readable)

                self.status.on_readable(readable)
                self.pump_status()

                # Give freshly produced output a chance to leave before blocking
                # in select again.
                self.fill_pending()
                if self.pending_out and not self.flush_pending():
                    return 0
        finally:
            self.shutdown()

    def shutdown(self) -> None:
        for session in list(self.sessions.values()):
            self.teardown(session)
        self.status.shutdown()
        for proc in self.reaping:
            self.stop_process(proc)


def main() -> int:
    # A dead client must not kill us mid-teardown; the write path reports it.
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    return Mux().run()


if __name__ == "__main__":
    sys.exit(main())
