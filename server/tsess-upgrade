#!/bin/bash
set -euo pipefail

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
# shellcheck source=server/tsess-state
. "$script_directory/tsess-state"

if [ "$#" -ne 1 ]; then
    echo "usage: tsess-upgrade <session>" >&2
    exit 2
fi
session_name=$1
validate_session_name "$session_name"

binary_path="$script_directory/zmx"
if [ ! -f "$binary_path" ] || [ ! -x "$binary_path" ]; then
    homeattach_fail "missing installed executable '$binary_path'; run server/install.sh first"
    exit 1
fi

exec "$binary_path" upgrade "$session_name" "$binary_path"
